# Control plane (apps/api)
VIGIL_DATABASE_URL=postgres://vigil_app:vigil_app_dev@127.0.0.1:54329/vigil
VIGIL_OWNER_DATABASE_URL=postgres://vigil_owner:vigil_owner_dev@127.0.0.1:54329/vigil
# 32-byte hex. REQUIRED in production (encrypts stored secrets, signs agent run tokens).
VIGIL_SECRET_KEY=
# Shared secret between API and agent worker (also set in the agent worker's env). REQUIRED in production.
VIGIL_INTERNAL_TOKEN=
VIGIL_AGENTS_URL=http://127.0.0.1:8090
VIGIL_BROKER_URL=http://127.0.0.1:8080
VIGIL_WEB_ORIGIN=http://localhost:3000
VIGIL_DEFAULT_MODEL_PROVIDER=gemini
VIGIL_DEFAULT_MODEL=gemini-4-argon
VIGIL_MAX_PAGES_PER_JOB=50
VIGIL_INGEST_LAG_MINUTES=5
# AWS principal Vigil runs as (shown in customer onboarding trust policy)
VIGIL_AWS_PRINCIPAL_ARN=

# Agent worker (services/agents) — model credentials live ONLY here, never in the API or with agents' tools
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Use a PAID-tier Gemini API key: free-tier prompts may be used by Google to improve products.
GEMINI_API_KEY=
# Optional: low | medium | high (unset = model default)
VIGIL_GEMINI_THINKING_LEVEL=
