# Vigil self-hosted configuration. The installer copies this to .env (/opt/vigil/.env for release installs,
# deploy/.env for source installs) and fills every __GENERATE__ value with a random secret. Keep .env private
# (mode 600) and back it up: VIGIL_SECRET_KEY is required to decrypt stored credentials after a restore.
# docs/SELF_HOSTING.md's configuration reference is generated from the comments in this file.

# --- release ---
# Installed Vigil version; images are pinned to it. Changed only by upgrade/rollback.
VIGIL_VERSION=0.1.0
# Docker Compose project name (prefix of container and volume names).
COMPOSE_PROJECT_NAME=vigil

# --- images ---
# Registry for release images (vigil-api, vigil-web, vigil-agents), always pinned to VIGIL_VERSION. Point it at a
# mirror that preserves cosign signatures (e.g. `cosign copy`) for restricted networks.
VIGIL_IMAGE_REGISTRY=ghcr.io/onelab-x
# source = build images from a git checkout, release = pull prebuilt images. Empty = auto-detect.
VIGIL_INSTALL_MODE=
# Release image signature check with cosign: auto (verify if cosign is installed, warn otherwise), require, off.
VIGIL_VERIFY_SIGNATURES=auto

# --- web UI ---
# Address the web UI is published on when the built-in HTTPS proxy is off. Default: this host only (reach it over
# SSH or put your own TLS reverse proxy in front). With VIGIL_DOMAIN set the web UI is not published at all.
VIGIL_WEB_BIND=127.0.0.1
# Host port for the web UI when the built-in HTTPS proxy is off.
VIGIL_WEB_PORT=3000
# Public origin users browse to (used for CORS/cookies), e.g. https://vigil.example.com
VIGIL_WEB_ORIGIN=http://localhost:3000

# --- built-in HTTPS (Caddy) ---
# Set to publish 80/443 with automatic HTTPS, HTTP->HTTPS redirect and HSTS. DNS must point at this host.
VIGIL_DOMAIN=
# acme = Let's Encrypt (default) | custom = your cert/key files below | internal = Caddy's local CA | off
VIGIL_TLS_MODE=
# Contact email for the ACME account (expiry notices). Optional.
VIGIL_ACME_EMAIL=
# For VIGIL_TLS_MODE=custom: host path to the PEM certificate chain.
VIGIL_TLS_CERT_FILE=
# For VIGIL_TLS_MODE=custom: host path to the PEM private key.
VIGIL_TLS_KEY_FILE=

# --- secrets (generated) ---
# 32-byte hex key: encrypts stored credentials and signs agent run tokens. Never change it on an existing install.
VIGIL_SECRET_KEY=__GENERATE_HEX32__
# Shared secret between the API's tool broker and the agent service.
VIGIL_INTERNAL_TOKEN=__GENERATE__
# Postgres superuser (backup/restore only).
POSTGRES_PASSWORD=__GENERATE__
# Migration/owner role (BYPASSRLS; migrations and SECURITY DEFINER system functions only).
VIGIL_OWNER_DB_PASSWORD=__GENERATE__
# Runtime role (NOBYPASSRLS: every query is confined by row-level security).
VIGIL_APP_DB_PASSWORD=__GENERATE__
# Evidence store access key (bundled store: generated; external S3: your key, or empty to use the host's identity).
VIGIL_S3_ACCESS_KEY=__GENERATE__
# Evidence store secret key (see VIGIL_S3_ACCESS_KEY).
VIGIL_S3_SECRET_KEY=__GENERATE__

# --- evidence storage ---
# Bucket for write-once raw evidence. Bundled SeaweedFS (S3-compatible) by default; for external S3 / GCS-interop /
# Ceph / MinIO set bucket, endpoint, region and the key pair above (see docs/SELF_HOSTING.md).
VIGIL_S3_BUCKET=vigil-evidence
# S3 endpoint; http://objectstore:8333 is the bundled store.
VIGIL_S3_ENDPOINT=http://objectstore:8333
# S3 region.
VIGIL_S3_REGION=us-east-1

# --- ingestion ---
# Maximum API pages one ingestion job fetches before yielding (bounds job duration and API usage).
VIGIL_MAX_PAGES_PER_JOB=50
# Incremental polls stop this many minutes before now so late-arriving cloud logs are not missed.
VIGIL_INGEST_LAG_MINUTES=5

# --- cloud identity (read-only) ---
# Google Cloud. Leave empty on Compute Engine/GKE: the GCP connector (auth mode ADC) uses the VM's attached service
# account (roles/logging.viewer, + roles/logging.privateLogViewer for Data Access logs) — no key file. Elsewhere:
# host path to a Workload Identity Federation credential config (keyless). Avoid service-account keys.
VIGIL_GCP_CREDENTIALS_FILE=
# AWS principal Vigil runs as (shown in the customer onboarding trust policy). On EC2 this is the instance profile
# role (deploy/cloud/aws sets it); credentials come from IMDSv2 — never configure access keys.
VIGIL_AWS_PRINCIPAL_ARN=
# Azure workload identity federation outside Azure: host path to a short-lived OIDC token file kept fresh by your
# platform. On an Azure VM use the connector's "managed identity" auth mode instead — nothing to set here.
VIGIL_AZURE_FEDERATED_TOKEN_FILE=

# --- AI models (agent service only) ---
# Provider for newly created agent definitions (gemini, anthropic, openai, openai_compatible).
VIGIL_DEFAULT_MODEL_PROVIDER=gemini
# Model for newly created agent definitions. Providers and models can also be configured in Settings → AI models.
VIGIL_DEFAULT_MODEL=gemini-4-argon
# Optional provider keys, visible only to the agent service (never to the API, database or connectors).
GEMINI_API_KEY=
# Optional Anthropic API key (agent service only).
ANTHROPIC_API_KEY=
# Optional OpenAI API key (agent service only).
OPENAI_API_KEY=
# Optional Gemini thinking level override.
VIGIL_GEMINI_THINKING_LEVEL=
