# Vigil self-hosted configuration. install.sh copies this to deploy/.env and fills every
# __GENERATE__ value with a random secret. Keep deploy/.env private (mode 600) and back it up:
# VIGIL_SECRET_KEY is required to decrypt stored credentials after a restore.

VIGIL_VERSION=0.1.0
COMPOSE_PROJECT_NAME=vigil

# --- images ---
# Registry for release images (vigil-api, vigil-web, vigil-agents), always pinned to VIGIL_VERSION. Point it at a
# mirror that preserves cosign signatures (e.g. `cosign copy`) for restricted networks.
VIGIL_IMAGE_REGISTRY=ghcr.io/onelab-x
# source = build images from a git checkout, release = pull prebuilt images. Empty = auto-detect.
VIGIL_INSTALL_MODE=
# Release image signature check with cosign: auto (verify if cosign is installed, warn otherwise), require, off.
VIGIL_VERIFY_SIGNATURES=auto

# Web UI binding when the built-in TLS proxy is off. Default listens on this host only (reach it over SSH or put
# your own TLS reverse proxy in front). With VIGIL_DOMAIN set the web UI is not published at all.
VIGIL_WEB_BIND=127.0.0.1
VIGIL_WEB_PORT=3000
# Public origin users browse to (used for CORS/cookies), e.g. https://vigil.example.com
VIGIL_WEB_ORIGIN=http://localhost:3000

# --- built-in HTTPS (Caddy) ---
# Set VIGIL_DOMAIN to publish 80/443 with automatic HTTPS, HTTP->HTTPS redirect and HSTS. DNS must point here.
VIGIL_DOMAIN=
# acme = Let's Encrypt (default) | custom = your cert/key files below | internal = Caddy's local CA | off
VIGIL_TLS_MODE=
# Contact email for the ACME account (expiry notices). Optional.
VIGIL_ACME_EMAIL=
# For VIGIL_TLS_MODE=custom: host paths to a PEM certificate chain and its private key.
VIGIL_TLS_CERT_FILE=
VIGIL_TLS_KEY_FILE=

# --- secrets (generated) ---
VIGIL_SECRET_KEY=__GENERATE_HEX32__
VIGIL_INTERNAL_TOKEN=__GENERATE__
POSTGRES_PASSWORD=__GENERATE__
VIGIL_OWNER_DB_PASSWORD=__GENERATE__
VIGIL_APP_DB_PASSWORD=__GENERATE__
VIGIL_S3_ACCESS_KEY=__GENERATE__
VIGIL_S3_SECRET_KEY=__GENERATE__

# --- evidence storage ---
# Bundled SeaweedFS (S3-compatible) by default. For external S3 / GCS-interop / Ceph / MinIO, set the
# endpoint, region, bucket and the access key pair above (see docs/SELF_HOSTING.md).
VIGIL_S3_BUCKET=vigil-evidence
VIGIL_S3_ENDPOINT=http://objectstore:8333
VIGIL_S3_REGION=us-east-1

# --- ingestion / retention ---
VIGIL_MAX_PAGES_PER_JOB=50
VIGIL_INGEST_LAG_MINUTES=5

# --- Google Cloud access (read-only) ---
# Leave empty on Google Compute Engine/GKE: the GCP connector (auth mode ADC) then uses the VM's attached service
# account (roles/logging.viewer, + roles/logging.privateLogViewer for Data Access logs) — no key file.
# Elsewhere: host path to a Workload Identity Federation credential config (keyless). Avoid service-account keys.
VIGIL_GCP_CREDENTIALS_FILE=
# AWS principal Vigil runs as (shown in the customer onboarding trust policy). On EC2 this is the instance profile
# role (deploy/cloud/aws sets it); credentials come from IMDSv2 — never configure access keys.
VIGIL_AWS_PRINCIPAL_ARN=
# --- Azure access (read-only) ---
# On an Azure VM use the connector's "managed identity" auth mode — nothing to set here.
# Host path to a short-lived OIDC token file (kept fresh by your platform, e.g. AKS workload identity or a
# token projector) used for workload identity federation. Leave empty when using client-secret connections.
VIGIL_AZURE_FEDERATED_TOKEN_FILE=

# --- AI models (agent service only) ---
# Default model for new agent definitions. Providers can also be configured in Settings → AI models.
VIGIL_DEFAULT_MODEL_PROVIDER=gemini
VIGIL_DEFAULT_MODEL=gemini-4-argon
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VIGIL_GEMINI_THINKING_LEVEL=
